{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one-origin",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.js",
  "d1_databases": [
    {
      "binding": "database_binding",
      "database_id": "5e9f4890-a692-430b-aded-58e0282e2ad7"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_NAMESPACE",
      "id": "e696e4c51c9642c78c1c394d6e6df686"
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "NAMESPACE_Dispatch",
      "namespace": "one-origin",
      "outbound": {
        "service": "one-origin",
        "parameters": []
      }
    }
  ],
  "worker_loaders": [
    {
      "binding": "one-origin"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "oneorigin",
      "store_id": "b56dddabe7d74172932cf26f4a2ab03f",
      "secret_name": "Secret_store"
    }
  ]
}
