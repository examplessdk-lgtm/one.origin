{
  "name": "WorkspaceItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Name of the saved work"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "audio",
        "video",
        "code"
      ],
      "default": "text"
    },
    "prompt": {
      "type": "string",
      "description": "The original instruction given to the agent"
    },
    "content": {
      "type": "string",
      "description": "The agent's saved output"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
